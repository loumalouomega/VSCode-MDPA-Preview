// A 2x1 portal frame: two columns and a beam, plus a diagonal brace on a
// SECOND property so a mesh with mixed sections is exercised, and one
// LineCondition2D2N that must NOT be drawn as a tube on its own say-so.
Begin Properties 0
End Properties

Begin Properties 1
    DENSITY 7850.0
    CROSS_AREA 0.0201
    I22 [3] (1.0,2.0,3.0)
    CONSTITUTIVE_LAW TrussConstitutiveLaw
    Begin Table TEMPERATURE YOUNG_MODULUS
        200.0 2.1e11
        400.0 1.9e11
    End Table
End Properties

Begin Properties 2
    DENSITY 7850.0
    CROSS_AREA 0.0005
End Properties

Begin Properties 3
    DENSITY 7850.0
End Properties

Begin Nodes
1 0.0 0.0 0.0
2 0.0 3.0 0.0
3 4.0 3.0 0.0
4 4.0 0.0 0.0
5 2.0 3.0 0.0
End Nodes

Begin Elements CrLinearBeamElement3D2N
1 1 1 2
2 1 2 5
3 1 5 3
4 1 3 4
End Elements

Begin Elements TrussElement3D2N
5 2 1 5
6 2 5 4
End Elements

Begin Elements TrussElement3D2N
7 3 2 3
End Elements

Begin Conditions LineCondition2D2N
1 1 1 4
End Conditions

Begin SubModelPart Frame
    Begin SubModelPartNodes
    1
    2
    3
    4
    5
    End SubModelPartNodes
    Begin SubModelPartElements
    1
    2
    3
    4
    End SubModelPartElements
End SubModelPart

Begin SubModelPart Bracing
    Begin SubModelPartNodes
    1
    4
    5
    End SubModelPartNodes
    Begin SubModelPartElements
    5
    6
    End SubModelPartElements
End SubModelPart
