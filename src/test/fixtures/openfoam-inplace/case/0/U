FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (1 0 0);

boundaryField
{
    inlet { type fixedValue; value uniform 5; }
    outlet { type zeroGradient; }
    bottom { type cyclic; }
    top { type cyclic; }
    walls { type zeroGradient; }
}
