    "vtkwasm:fetch": "node scripts/vtk-wasm/fetch.mjs --candidate latest-9.7.20261018",
    "vtkwasm:prepare": "node scripts/vtk-wasm/prepare-assets.mjs",
    "build:tests": "tsc -p ./tsconfig.test.json",
    "test": "npm run build:tests && node --test out/test/",
    "mcp": "node dist/mcpServer.js",
    "bench:heartbeat": "node scripts/bench/host-heartbeat.mjs",
    "bench:plot": "node scripts/bench/plot-budget.mjs",
    "bench:large-mesh": "node scripts/bench/large-mesh.mjs",
    "install-ext": "bash install.sh",
    "reinstall": "bash scripts/reinstall-local.sh"
  },
