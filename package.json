        "key": "ctrl+o",
        "mac": "cmd+o",
        "when": "activeCustomEditorId == 'kratos.mdpaPreview' || activeCustomEditorId == 'kratos.vtkPreview'"
      },
      {
        "command": "kratos.mesh.reload",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "activeCustomEditorId == 'kratos.mdpaPreview' || activeCustomEditorId == 'kratos.vtkPreview'"
      },
      {
        "command": "kratos.mesh.save",
        "key": "ctrl+s",
        "mac": "cmd+s",
        "when": "activeCustomEditorId == 'kratos.mdpaPreview' || activeCustomEditorId == 'kratos.vtkPreview'"
      },
      {
        "command": "kratos.mesh.saveAs",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s",
        "when": "activeCustomEditorId == 'kratos.mdpaPreview' || activeCustomEditorId == 'kratos.vtkPreview'"
      },
      {
        "command": "kratos.mesh.undo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "activeCustomEditorId == 'kratos.mdpaPreview' || activeCustomEditorId == 'kratos.vtkPreview'"
      },
      {
        "command": "kratos.mesh.redo",
        "key": "ctrl+shift+z",
        "mac": "cmd+shift+z",
        "when": "activeCustomEditorId == 'kratos.mdpaPreview' || activeCustomEditorId == 'kratos.vtkPreview'"
      },
      {
        "command": "kratos.mesh.export",
        "key": "ctrl+e",
        "mac": "cmd+e",
        "when": "activeCustomEditorId == 'kratos.mdpaPreview' || activeCustomEditorId == 'kratos.vtkPreview'"
      },
      {
        "command": "kratos.problem.save",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s",
        "when": "activeCustomEditorId == 'kratos.mdpaPreview' || activeCustomEditorId == 'kratos.vtkPreview'"
      },
      {
        "command": "kratos.problem.load",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o",
        "when": "activeCustomEditorId == 'kratos.mdpaPreview' || activeCustomEditorId == 'kratos.vtkPreview'"
      },
      {
        "command": "kratos.mdpa.screenshot",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "activeCustomEditorId == 'kratos.mdpaPreview' || activeCustomEditorId == 'kratos.vtkPreview'"
      }
    ],
