  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "languages": [
      {
        "id": "mdpa",
        "aliases": [
          "Kratos MDPA",
          "mdpa"
        ],
        "extensions": [
          ".mdpa"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mdpa",
        "scopeName": "source.mdpa",
        "path": "./syntaxes/mdpa.tmLanguage.json"
      }
    ],
