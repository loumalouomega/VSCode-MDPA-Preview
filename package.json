          "when": "false"
        },
        {
          "command": "kratos.runs.exportOptimizedCad",
          "when": "false"
        },
        {
          "command": "kratos.runs.plotSingularValues",
          "when": "false"
        },
        {
          "command": "kratos.runs.showHromElements",
          "when": "false"
        },
        {
          "command": "kratos.runs.exportMonitors",
