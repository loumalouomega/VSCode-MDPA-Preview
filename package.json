        },
        {
          "command": "kratos.runs.exportMonitors",
          "when": "(view == kratos.runs || view == kratos.runsSidebar) && viewItem =~ /^kratosRun\\./"
        },
        {
          "command": "kratos.runs.plotMonitors",
          "when": "(view == kratos.runs || view == kratos.runsSidebar) && viewItem =~ /^kratosRun\\./"
        },
        {
          "command": "kratos.runs.revealCase",
          "when": "(view == kratos.runs || view == kratos.runsSidebar) && viewItem =~ /^kratosRun\\./"
        },
        {
          "command": "kratos.runs.compare",
          "when": "(view == kratos.runs || view == kratos.runsSidebar) && viewItem =~ /^kratosRun\\.(finished|failed|cancelled)$/"
        },
        {
          "command": "kratos.runs.remove",
          "when": "(view == kratos.runs || view == kratos.runsSidebar) && viewItem =~ /^kratosRun\\.(finished|failed|cancelled|orphaned)$/"
        },
        {
          "command": "kratos.recent.remove",
          "when": "view == kratos.recentMeshes && viewItem == kratosRecentMesh",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "kratos.runs.stop",
          "when": "false"
        },
        {
          "command": "kratos.runs.showLog",
          "when": "false"
        },
        {
          "command": "kratos.runs.openResults",
          "when": "false"
        },
        {
          "command": "kratos.runs.remove",
          "when": "false"
