{
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2021",
    "lib": [
      "ES2021"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": false,
    "rootDir": "src",
    "outDir": "out"
  },
  "include": [
    "src/parser/**/*.ts",
    "src/meshAnalysis.ts",
    "src/problemtype/**/*.ts",
    "src/mmgWorker.ts",
    "src/mmgWorkerClient.ts",
    "src/streamlineWorker.ts",
    "src/streamlineWorkerClient.ts",
    "src/plotWorker.ts",
    "src/plotWorkerClient.ts",
    "src/oracleOpWorker.ts",
    "src/oracleOpWorkerClient.ts",
    "src/analysisWorker.ts",
    "src/analysisWorkerClient.ts",
    "src/analysisSupersede.ts",
    "src/seriesScanJob.ts",
    "src/seriesScanHost.ts",
    "src/seriesScanWorker.ts",
    "src/seriesScanWorkerClient.ts",
    "src/mcp/tools.ts",
    "src/webviewChrome.ts",
    "src/flowgraphServer.ts",
    "src/flowgraphMessages.ts",
    "src/test/**/*.ts"
  ]
}
