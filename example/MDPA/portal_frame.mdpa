Begin ModelPartData
//  VARIABLE_NAME value
End ModelPartData

// A portal frame, for the beam rendering (Advanced > Beams...).
//
// Two columns and a top beam on Properties 1, a pair of diagonal braces on
// Properties 2 with a much smaller CROSS_AREA, one tie on Properties 3 which
// declares no section at all, and a LineCondition2D2N along the base. So one
// small file shows all three rules: sections resolve PER CELL (the braces and
// the tie share one merged Elements block), a cell with no section falls back
// to the viewer's constant, and a line CONDITION is not drawn as a tube even
// though it references a property that has a section.
Begin Properties 0
End Properties

Begin Properties 1
    DENSITY 7850.0
    CROSS_AREA 0.0201
    I22 [3] (1.0,2.0,3.0)
    CONSTITUTIVE_LAW TrussConstitutiveLaw
    Begin Table TEMPERATURE YOUNG_MODULUS
        200.0 2.1e11
        400.0 1.9e11
    End Table
End Properties

Begin Properties 2
    DENSITY 7850.0
    CROSS_AREA 0.0005
End Properties

Begin Properties 3
    DENSITY 7850.0
End Properties

Begin Nodes
1 0.0 0.0 0.0
2 0.0 3.0 0.0
3 4.0 3.0 0.0
4 4.0 0.0 0.0
5 2.0 3.0 0.0
End Nodes

Begin Elements CrLinearBeamElement3D2N
1 1 1 2
2 1 2 5
3 1 5 3
4 1 3 4
End Elements

Begin Elements TrussElement3D2N
5 2 1 5
6 2 5 4
End Elements

Begin Elements TrussElement3D2N
7 3 2 3
End Elements

Begin Conditions LineCondition2D2N
1 1 1 4
End Conditions

Begin SubModelPart Frame
    Begin SubModelPartNodes
    1
    2
    3
    4
    5
    End SubModelPartNodes
    Begin SubModelPartElements
    1
    2
    3
    4
    End SubModelPartElements
End SubModelPart

Begin SubModelPart Bracing
    Begin SubModelPartNodes
    1
    4
    5
    End SubModelPartNodes
    Begin SubModelPartElements
    5
    6
    End SubModelPartElements
End SubModelPart
